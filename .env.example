# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file — .gitignore already excludes it.
#
# Get these from the Spotify Developer Dashboard:
#   https://developer.spotify.com/dashboard
#   Create an app, then copy its Client ID and Client Secret.
#
# spotipy reads these exact variable names from the environment automatically,
# so keep the names as-is. With both set, you can construct the client with no
# arguments:  SpotifyClientCredentials()

SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
